#!/bin/bash
# 配置变更后：应用设置里改的访问令牌落盘，供 cmd/main 启动时 --token 使用。
# 入口 URL 由 fnOS 依据向导值 wizard_path 自动生成（ui/config 的 url 就是
# /?token=${wizard_path}），因此这里不必改任何文件。
set -e

APP="zcode"
if [ -z "${TRIM_PKGVAR}" ] && [ -d "/var/apps/${APP}/var" ]; then
    TRIM_PKGVAR="$(readlink -f "/var/apps/${APP}/var")"
fi

TOKEN="${wizard_path:-${wizard_token:-}}"
if [ -z "${TOKEN}" ]; then
    exit 0
fi

mkdir -p "${TRIM_PKGVAR}/etc"
printf '%s' "${TOKEN}" > "${TRIM_PKGVAR}/etc/token"
chmod 600 "${TRIM_PKGVAR}/etc/token" 2>/dev/null || true
chown -R "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${TRIM_PKGVAR}/etc" 2>/dev/null || true
exit 0
